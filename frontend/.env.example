# Written for you by `node deploy/deploy.mjs` (as frontend/.env.local). Copy and edit by hand to point
# the app at a contract you deployed some other way. Nothing here is a secret: Studionet is gasless
# and the demo accounts are throwaway keys generated in each visitor's browser.

# GenLayer network. Studionet: https://studio.genlayer.com/api, chain 61999.
# Localnet (GenLayer Studio on your machine): http://localhost:4000/api, chain 61127.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com

# The deployed ChargebackCourt contract.
NEXT_PUBLIC_CHARGEBACK_ADDRESS=0x0000000000000000000000000000000000000000

# Public https origin that serves this app's /fixtures/* pages. Validators fetch the evidence
# themselves, so it cannot be localhost. Leave empty on Vercel (the app uses its own origin);
# set it to your tunnel when running locally, or paste it into the in-app banner instead.
NEXT_PUBLIC_FIXTURE_BASE_URL=

# Used only by `demo/run.ts` (the end-to-end script), not by the app.
FIXTURE_BASE_URL=
